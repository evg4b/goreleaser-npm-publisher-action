{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "coverage", "__fixtures__", "__tests__"]
}

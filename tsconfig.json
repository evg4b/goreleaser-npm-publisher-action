{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "rootDir": "./src",
    "moduleResolution": "Bundler",
    "sourceMap": true,
    "outDir": "./dist",
    "noImplicitAny": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "newLine": "lf"
  },
  "exclude": [
    "./dist",
    "./node_modules",
    "./__fixtures__",
    "./__tests__",
    "./coverage"
  ]
}

{
  "name": "typescript-action",
  "description": "GitHub Actions TypeScript template",
  "version": "1.6.1",
  "author": "",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/actions/typescript-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com:evg4b/goreleaser-npm-publisher-action.git"
  },
  "bugs": {
    "url": "https://github.com/actions/typescript-action/issues"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "yarn run format:write && yarn run package",
    "ci-test": "npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "package": "npx ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "package:watch": "yarn run package -- --watch",
    "test": "npx jest",
    "all": "yarn run format:write && yarn run lint && yarn run test && yarn run coverage && yarn run package"
  },
  "license": "MIT",
  "jest": {
    "preset": "ts-jest",
    "verbose": true,
    "clearMocks": true,
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "moduleNameMapper": {
      "^@actions/core$": "<rootDir>/__fixtures__/core.ts"
    },
    "testMatch": [
      "**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./src/**"
    ]
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "goreleaser-npm-publisher": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.9.9",
    "prettier-eslint": "^17.1.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.18.1"
}

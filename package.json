{
  "name": "goreleaser-npm-publisher-action",
  "description": "Build and publish npm packages based on goreleaser output folder",
  "version": "1.7.0",
  "author": "Evgeny Abramovich",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/evg4b/goreleaser-npm-publisher-action#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evg4b/goreleaser-npm-publisher-action.git"
  },
  "bugs": {
    "url": "https://github.com/evg4b/goreleaser-npm-publisher-action/issues"
  },
  "keywords": [
    "actions",
    "goreleaser",
    "npm",
    "publish"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "yarn run format:write && yarn run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.js",
    "package:watch": "yarn run package --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "yarn run format:write && yarn run lint && yarn run test && yarn run coverage && yarn run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "goreleaser-npm-publisher": "^1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.5.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.2",
    "ts-jest": "^29.4.14",
    "ts-jest-resolver": "^2.0.1",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "yarn@4.18.1"
}
